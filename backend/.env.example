# Kopiraj ovaj fajl u .env i popuni vrednosti.

NODE_ENV=development
PORT=3000

# Adrese sajta kojima je dozvoljeno da šalju formu (odvojene zarezom)
CORS_ORIGINS=http://localhost:4200,http://localhost:4000

# Gde se čuva rezervna kopija svake poruke (jedna poruka = jedan red)
MESSAGES_FILE=data/poruke.jsonl

# SMTP — nalog sa kog se šalju mejlovi. Lokalno može da ostane prazno:
# tada se poruke samo ispisuju u terminal i upisuju u fajl.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sretenjski bal <no-reply@sretenjskibal.si>"

# Na koju adresu stižu poruke sa sajta
MAIL_TO=

# Rezervacije karata — Google Apps Script web aplikacija vezana za tabelu „Bal rezervacije".
# Uputstvo: docs/REZERVACIJE.md. Lokalno može da ostane prazno: rezervacije se tada upisuju
# u RESERVATIONS_DEV_FILE i mejlovi se ne šalju. U produkciji bez ovoga rezervacije su zatvorene.
# TODO: u produkcionom .env upisati URL web aplikacije (…/exec) i ključ iz tabele
# (meni Sretenjski bal → Prikaži ključ za sajt). Ključ nikad ne ide u git.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
APPS_SCRIPT_TIMEOUT_MS=40000
RESERVATIONS_DEV_FILE=data/rezervacije-dev.jsonl
